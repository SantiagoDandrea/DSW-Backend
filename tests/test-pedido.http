POST http://localhost:3000/api/productos
Content-Type: application/json

{
  "nombre": "Amoladora Angular 4 1/2",
  "descripcion": "Amoladora angular 850W",
  "categoriaId": ID_CATEGORIA,
  "marcaId": ID_MARCA,
  "proveedorId": ID_PROVEEDOR,
